Bind(RunService.Heartbeat, function()
    local hum, hrp, cam = Hum(), HRP(), workspace.CurrentCamera
    if hum then
        if F.Speed then hum.WalkSpeed = S.Speed end
        if F.Jump then hum.UseJumpPower = true; hum.JumpPower = S.Jump end
    end
    if F.Grav then workspace.Gravity = S.Gravity end
    if F.FOV and cam then cam.FieldOfView = S.FOV end
    if F.Fly and hum and hrp and EnsureFly() then
        local dir = hum.MoveDirection
        local up = (UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.LeftControl) and 1 or 0)
        local vel = dir * S.FlySpeed + Vector3.new(0, up * S.FlySpeed, 0)
        local look = cam.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if dir.Magnitude > 0 and flat.Magnitude > 0 then
            vel = vel + Vector3.new(0, look.Y * dir:Dot(flat.Unit) * S.FlySpeed, 0)
        end
        flyBV.Velocity = vel
        flyBG.CFrame = cam.CFrame
    end
    if F.Farm and hrp then
        local coin = NearestCoin(S.FarmRange)
        if coin then
            local pos = PartPos(coin)
            if pos then
                hrp.CFrame = CFrame.new(pos + Vector3.new(0, S.FarmHeight, 0), pos)
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end
    if F.Full then
        Lighting.Brightness = 2; Lighting.ClockTime = 14; Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(178, 178, 178); Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
    end
    if F.Fog then
        Lighting.FogEnd = 9e9
        local a = Lighting:FindFirstChildOfClass(string.char(65,116,109,111,115,112,104,101,114,101)); if a then a.Density = 0 end
    end
end)

