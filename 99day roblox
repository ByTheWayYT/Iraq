local function FindFolders(names)
    local found = {}
    for _, n in ipairs(names) do
        local f = workspace:FindFirstChild(n, true)
        if f then found[#found + 1] = f end
    end
    return found
end

local function PartPos(inst)
    if inst:IsA(string.char(66,97,115,101,80,97,114,116)) then return inst.Position end
    if inst:IsA(string.char(77,111,100,101,108)) then
        local ok, cf = pcall(function() return inst:GetPivot() end)
        if ok then return cf.Position end
        local pp = inst.PrimaryPart or inst:FindFirstChildWhichIsA(string.char(66,97,115,101,80,97,114,116), true)
        if pp then return pp.Position end
    end
    return nil
end

local coinFolderCache, coinFolderT = {}, 0
local function CoinFolders()
    if os.clock() - coinFolderT > 5 or #coinFolderCache == 0 then
        coinFolderT = os.clock()
        coinFolderCache = FindFolders(NAMES.CoinFolders)
    end
    return coinFolderCache
end

local function CoinList()
    local t = {}
    local folders = CoinFolders()
    if #folders > 0 then
        for _, folder in ipairs(folders) do
            for _, o in ipairs(folder:GetChildren()) do
                if (o:IsA(string.char(66,97,115,101,80,97,114,116)) or o:IsA(string.char(77,111,100,101,108))) and tostring(o.Name):find(NAMES.CoinNamePart, 1, true) then
                    t[#t + 1] = o
                end
            end
        end
    elseif NAMES.CoinNamePart ~= "" then
        for _, o in ipairs(workspace:GetDescendants()) do
            if (o:IsA(string.char(66,97,115,101,80,97,114,116)) or o:IsA(string.char(77,111,100,101,108))) and tostring(o.Name):find(NAMES.CoinNamePart) then
                t[#t + 1] = o
            end
        end
    end
    return t
end

local function NearestCoin(range)
    local hrp = HRP(); if not hrp then return end
    local best, bd
    for _, o in ipairs(CoinList()) do
        local pos = PartPos(o)
        if pos then
            local d = (pos - hrp.Position).Magnitude
            if (not range or d <= range) and (not bd or d < bd) then best, bd = o, d end
        end
    end
    return best, bd
end

local dropCache, dropT = {}, 0
local function DropList()
    if os.clock() - dropT > 2 then
        dropT = os.clock()
        dropCache = {}
        local folders = FindFolders(NAMES.DropFolders)
        local scan = function(root)
            for _, o in ipairs(root:GetDescendants()) do
                if o:IsA(string.char(66,97,115,101,80,97,114,116)) or o:IsA(string.char(77,111,100,101,108)) then
                    local nm = tostring(o.Name)
                    for _, part in ipairs(NAMES.DropNameParts) do
                        if nm:find(part) then dropCache[#dropCache + 1] = o break end
                    end
                end
            end
        end
        if #folders > 0 then for _, f in ipairs(folders) do scan(f) end else scan(workspace) end
    end
    return dropCache
end

local function NearestDrop(range)
    local hrp = HRP(); if not hrp then return end
    local best, bd
    for _, o in ipairs(DropList()) do
        if o.Parent then
            local pos = PartPos(o)
            if pos then
                local d = (pos - hrp.Position).Magnitude
                if (not range or d <= range) and (not bd or d < bd) then best, bd = o, d end
            end
        end
    end
    return best, bd
end

-- Picking up a coin/weapon is game-specific: most maps use a Touch
-- event or a ProximityPrompt. We try both so this works on many versions; if
-- your server uses a RemoteEvent instead, tell me its name/path and I will
-- wire it in directly.
local function TryTouch(inst)
    local part = inst:IsA(string.char(66,97,115,101,80,97,114,116)) and inst or (inst.PrimaryPart or inst:FindFirstChildWhichIsA(string.char(66,97,115,101,80,97,114,116), true))
    if not part then return end
    local prompt = inst:FindFirstChildWhichIsA(string.char(80,114,111,120,105,109,105,116,121,80,114,111,109,112,116), true)
    if prompt then pcall(function() fireproximityprompt(prompt) end) return end
    local hrp = HRP()
    if hrp then
        pcall(function() firetouchinterest(hrp, part, 0) end)
        pcall(function() firetouchinterest(hrp, part, 1) end)
    end
end

