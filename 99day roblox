local function TeleportTo(cf)
    local hrp = HRP(); if not hrp then return end
    local d = (hrp.Position - cf.Position).Magnitude
    local t = math.max(d / math.max(S.TweenSpeed, 50), 0.05)
    F.Tweening = true
    local tw = TweenService:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = cf })
    tw.Completed:Connect(function() F.Tweening = false end)
    tw:Play()
    return tw
end

