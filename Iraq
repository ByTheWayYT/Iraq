rebuildMenu = function()
	local visible = menuFrame == nil or menuFrame.Visible
	local pos = menuFrame and menuFrame.Position
	buildMenu()
	if menuFrame then menuFrame.Visible = visible if pos then menuFrame.Position = pos end end
end

-- 1-second ticker: FPS, live labels, key expiry
task.spawn(function()
	while alive do
		task.wait(1)
		fpsShown = fpsCount fpsCount = 0
		if menuGui then
			for _, f in ipairs(dyn) do pcall(f) end
			if not sessionValid() then
				notify(L("⏰ انتهى المفتاح! جدّده للمتابعة", "⏰ Key expired! Renew to continue"))
				resetFeatures()
				destroyMenu()
				showKeySystem(function() buildMenu() end, true)
			end
		end
	end
end)

track(UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.Insert then cleanup()
	elseif input.KeyCode == Enum.KeyCode.RightShift and menuFrame then menuFrame.Visible = not menuFrame.Visible end
end))

