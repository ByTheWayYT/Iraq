Games.memory = function(x)
	local syms = {"A", "B", "C", "D", "E", "F", "G", "H"}
	local deck = {}
	for _, sy in ipairs(syms) do deck[#deck + 1] = sy deck[#deck + 1] = sy end
	for i = #deck, 2, -1 do local j = math.random(i) deck[i], deck[j] = deck[j], deck[i] end
	local btns, open, locked, matched, moves = {}, {}, false, 0, 0
	for i = 1, 16 do
		local r, c = math.floor((i - 1) / 4), (i - 1) % 4
		local b = U.new("TextButton", {Size = UDim2.new(0, 74, 0, 74), Position = UDim2.new(0, 6 + c * 78, 0, 6 + r * 78), BackgroundColor3 = C.row, Text = "?",
			TextColor3 = C.white, Font = Enum.Font.GothamBold, TextSize = 28}, x.canvas)
		U.round(b, 10)
		btns[i] = b
		b.MouseButton1Click:Connect(function()
			if locked or b.Text ~= "?" then return end
			b.Text = deck[i] b.BackgroundColor3 = C.accent
			open[#open + 1] = i
			if #open == 2 then
				moves = moves + 1 x.setScore(moves)
				local a, d = open[1], open[2]
				if deck[a] == deck[d] then
					matched = matched + 1 open = {}
					btns[a].BackgroundColor3 = C.on btns[d].BackgroundColor3 = C.on
