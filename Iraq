-- music
function E.stopMusic() if sound then pcall(function() sound:Stop() sound:Destroy() end) sound = nil end end
function E.play(i)
	local pl = S.Playlist
	if #pl == 0 then return end
	if i < 1 then i = #pl elseif i > #pl then i = 1 end
	S.PlIndex = i
	E.stopMusic()
	local snd = U.new("Sound", {Name = "BTW_Music", SoundId = "rbxassetid://" .. tostring(pl[i].id), Looped = S.MusicLoop and true or false,
		Volume = S.MusicVol, PlaybackSpeed = S.MusicSpeed}, SoundService)
	sound = snd
	snd.Ended:Connect(function()
		if alive and sound == snd and not S.MusicLoop and snd.TimeLength > 0 then E.play(S.PlIndex + 1) end
	end)
	snd:Play()
	U.dirty = true
end
function E.sound() return sound end

