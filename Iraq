			v = math.clamp(math.floor(v / step + 0.5) * step, mn, mx)
			v = tonumber(string.format("%.3f", v))
			S[key] = v show(v) U.dirty = true
			if user and chip and not S[key .. "On"] then S[key .. "On"] = true paintChip() if onChip then pcall(onChip, true) end end
			if onSet then pcall(onSet, v) end
		end
		if type(S[key]) ~= "number" then S[key] = mn end
		if S[key] > mx then S[key] = mx end
		show(S[key])
		local page = cur
		local dragging = false
		local function fromX(x) setV(mn + (mx - mn) * math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1), true) end
