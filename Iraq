local function httpReq(opts)
	local r = (syn and syn.request) or http_request or request or (http and http.request)
	if not r then return nil end
	local ok, res = pcall(r, opts)
	if ok and type(res) == "table" and res.StatusCode and res.StatusCode >= 200 and res.StatusCode < 300 then return res.Body or "" end
	return nil
end
function Net.base()
	local b = tostring(EXTRA.BackendURL or "")
	if b == "" then return nil end
	return (b:gsub("/+$", ""))
end
function Net.get(path, q)
	local b = Net.base()
	if not b then return nil end
	local body = httpReq({Url = b .. "/" .. path .. ".json" .. (q or ""), Method = "GET"})
	if not body then return nil end
	if body == "null" or body == "" then return {} end
	local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
	if ok and type(d) == "table" then return d end
	return nil
end
function Net.post(path, data)
	local b = Net.base()
	if not b then return false end
	data.t = {[".sv"] = "timestamp"}
	return httpReq({Url = b .. "/" .. path .. ".json", Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)}) ~= nil
end
function Net.delete(path)
	local b = Net.base()
	if not b then return false end
	return httpReq({Url = b .. "/" .. path .. ".json", Method = "DELETE"}) ~= nil
end
function Net.sorted(d)
	local arr = {}
	for k, v in pairs(d) do if type(v) == "table" then v.k = tostring(k) arr[#arr + 1] = v end end
	table.sort(arr, function(a, b) return a.k < b.k end)
	return arr
end
