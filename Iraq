-- Tap Rush (hit the targets for 20 seconds)
Games.tapr = function(x)
	local canvas = x.canvas
	local score = 0
	local timeLbl = U.new("TextLabel", {Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, TextColor3 = C.gold, Font = Enum.Font.GothamBold, TextSize = 14, Text = "20.0"}, canvas)
	local target = U.new("TextButton", {Size = UDim2.new(0, 56, 0, 56), BackgroundColor3 = C.accent, Text = "🎯", TextSize = 26, Font = Enum.Font.GothamBold, TextColor3 = C.white}, canvas)
	U.round(target, 28)
	local function move() target.Position = UDim2.new(0, math.random(0, 264), 0, math.random(26, 260)) end
	move()
	target.MouseButton1Click:Connect(function() score = score + 1 x.setScore(score) move() end)
	task.spawn(function()
		local start = os.clock()
		while x.live() do
			local t = math.max(0, 20 - (os.clock() - start))
			timeLbl.Text = string.format("%.1f", t)
			if t <= 0 then target:Destroy() x.over(score * 3, "TIME UP ⏱") return end
			task.wait(0.05)
		end
	end)
end

