local function afterUnlock()
	-- daily rewards window: opens right after the key step (or directly if the key is already saved)
	if S.DailyAuto ~= false then
		task.delay(0.8, function() if alive and Daily.can() then Daily.open() end end)
	end
	if S.FPSCap and setfpscap then pcall(setfpscap, S.FPSCap) end
	buildMenu()
	local today = os.date("%Y-%m-%d")
	if S.LastDay ~= today then
		local yest = os.date("%Y-%m-%d", os.time() - 86400)
		S.Streak = (S.LastDay == yest) and ((S.Streak or 0) + 1) or 1
		local bonus = 50 + math.min(S.Streak, 7) * 10
		S.LastDay = today addXP(bonus) U.dirty = true
		local shown = isPaid() and bonus * 2 or bonus
		local msg = L("🎁 مكافأة يومية +", "🎁 Daily bonus +") .. shown .. " XP  🔥" .. S.Streak
		U.notify(msg)
		U.push(msg, "quest")
	else
		U.notify(L("أهلاً! المتبقي: ", "Welcome! Left: ") .. U.fmtTime(session.expires - os.time()))
	end
end
local function startFlow()
	runLoadingBar(function()
		if sessionValid() then afterUnlock() else showKeySystem(afterUnlock, session.type ~= nil) end
	end)
end
