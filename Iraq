local function addXP(n, noCoins)
	if isPaid() then n = n * 2 end
	if os.time() < (S.BoostUntil or 0) then n = n * 2 end
	local before = levelOf(S.XP)
	S.XP = (S.XP or 0) + n
	if not noCoins then S.Coins = (S.Coins or 0) + math.max(1, math.floor(n / 2)) end
	local after = levelOf(S.XP)
	U.dirty = true
	if after > before then U.levelUp = after end
end
