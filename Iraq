	if S.Spin and hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(S.SpinSpeed or 20), 0) end
	if S.DayNight then Lighting.ClockTime = (Lighting.ClockTime + 0.02) % 24 end
