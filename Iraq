function Quest.set(id, v)
	Quest.reset()
	for _, q in ipairs(QUESTS) do
		if q.id == id then
			local old = S.Quests[id] or 0
			if old >= q.goal then return end
			S.Quests[id] = math.min(q.goal, v)
			U.dirty = true
			if S.Quests[id] >= q.goal then
