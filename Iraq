local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function round(o, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 6)}, o) end

local function mkGui(name)
	local g = Instance.new("ScreenGui")
	g.Name = name g.ResetOnSpawn = false g.IgnoreGuiInset = true g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function()
		if syn and syn.protect_gui then syn.protect_gui(g) g.Parent = game:GetService("CoreGui")
		elseif gethui then g.Parent = gethui()
		else g.Parent = game:GetService("CoreGui") end
	end)
	if not g.Parent then g.Parent = LP:WaitForChild("PlayerGui") end
	guis[#guis + 1] = g
	return g
end

local function makeDraggable(handle, target, bucket)
	local dragging, dragStart, startPos
	bucket(handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true dragStart = input.Position startPos = target.Position
			input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
		end
	end))
	bucket(UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
end

-- ===================== KEY / SESSION SYSTEM =====================
local function isDev() return CONFIG.Developers[LP.Name] == true end
local function isPaid() return session.type == "Paid" or isDev() or CONFIG.AllowedSubscribers[LP.Name] == true end
local function limit(kind) return (isPaid() and Rules.Paid or Rules.Free)[kind] end
local function clampTo(v, kind)
	local m = limit(kind)
	if v > m then notify(L("الحد الأقصى لنسختك: ", "Your max: ") .. m) return m end
	return v
end
local function sessionValid() return session.type ~= nil and session.expires > os.time() end

local function fmtTime(sec)
	if sec <= 0 then return "0s" end
	local d = math.floor(sec / 86400) local h = math.floor(sec % 86400 / 3600)
	local m = math.floor(sec % 3600 / 60) local s = math.floor(sec % 60)
	if d > 0 then return string.format("%dd %02dh %02dm %02ds", d, h, m, s) end
	return string.format("%02dh %02dm %02ds", h, m, s)
end

local function saveSession()
	if writefile then
		pcall(writefile, SAVE_FILE, HttpService:JSONEncode({type = session.type, expires = session.expires, user = LP.Name}))
	end
end
local function loadSession()
	if readfile and isfile then
		local ok, data = pcall(function()
			if isfile(SAVE_FILE) then return HttpService:JSONDecode(readfile(SAVE_FILE)) end
		end)
		if ok and type(data) == "table" and data.user == LP.Name and (data.type == "Free" or data.type == "Paid") then
			session.type = data.type session.expires = tonumber(data.expires) or 0
		end
	end
end

-- Verify OR renew. Returns ok, reason
local function applyKey(entered, wantType)
	entered = tostring(entered or ""):gsub("%s", "")
	local expected = (wantType == "Paid") and CONFIG.PaidKey or CONFIG.FreeKey
	if entered ~= expected then return false, "invalid" end
	local now = os.time()
	local active = sessionValid()
	if wantType == "Free" and active and session.type == "Paid" then return false, "paid_active" end
	local base = now
	if wantType == "Paid" and active and session.type == "Paid" then base = session.expires end -- paid time stacks
	session.type = wantType
	session.expires = base + Rules[wantType].dur
	saveSession()
	return true
end

