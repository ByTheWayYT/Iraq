U.track(UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.Insert then cleanup()
	elseif input.KeyCode == Enum.KeyCode.RightShift and UI.frame then UI.frame.Visible = not UI.frame.Visible end
	if UIS:GetFocusedTextBox() then return end
	local need = {Fly = "FLY", Noclip = "PLAYER", ESP = "ESP", ClickTp = "TP"}
	for act, key in pairs(S.Keys) do
		if input.KeyCode.Name == key then
			if act == "Panic" then panic()
			elseif need[act] and unlocked(need[act]) then
				S[act] = not S[act]
				U.notify(act .. (S[act] and " ON" or " OFF"))
				if UI.gui and UI.frame and UI.frame.Visible then rebuildMenu() end
			end
		end
	end
end))

