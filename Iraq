U.fps = 0
U.track(RunService.RenderStepped:Connect(function()
	U.fps = U.fps + 1
	if S.Fly then
		local hrp, hum, c = U.hrp(), U.hum(), U.cam()
		if hrp and hum and c then
			flyOn = true
			if not flyBV or flyBV.Parent ~= hrp then
				if flyBV then flyBV:Destroy() end
				flyBV = U.new("BodyVelocity", {MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero}, hrp)
			end
			if not flyBG or flyBG.Parent ~= hrp then
				if flyBG then flyBG:Destroy() end
				flyBG = U.new("BodyGyro", {MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 90000}, hrp)
			end
			hum.PlatformStand = true
			local cf = c.CFrame
			local md = hum.MoveDirection
			local dir = Vector3.zero
			if md.Magnitude > 0 then
				local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
				local rflat = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
				if flat.Magnitude > 0 and rflat.Magnitude > 0 then
					dir = cf.LookVector * md:Dot(flat.Unit) + cf.RightVector * md:Dot(rflat.Unit)
				end
			end
			local up = 0
			if S.FlyUp or UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then up = up + 1 end
			if S.FlyDown or UIS:IsKeyDown(Enum.KeyCode.Q) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then up = up - 1 end
			if S.Hover and md.Magnitude == 0 and up == 0 then flyBV.Velocity = Vector3.zero
			else flyBV.Velocity = (dir + Vector3.new(0, up, 0)) * S.FlySpeed end
			flyBG.CFrame = cf
		end
	elseif flyOn then
		E.killFly()
	end
	if S.Tracers and Drawing then
		local c = U.cam()
		local vp = c.ViewportSize
		local col = S.ESPRainbow and Color3.fromHSV((os.clock() % 4) / 4, 1, 1) or S.ESPColor
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP then
				local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				local ln = lines[p]
				if hrp then
					if not ln then ln = Drawing.new("Line") ln.Thickness = 1.5 lines[p] = ln end
					local pos, on = c:WorldToViewportPoint(hrp.Position)
					ln.Visible = on ln.Color = col
					ln.From = Vector2.new(vp.X / 2, vp.Y) ln.To = Vector2.new(pos.X, pos.Y)
				elseif ln then ln.Visible = false end
			end
		end
	elseif next(lines) then
		E.clearLines()
	end
end))

task.spawn(function()
	while alive do
		task.wait(0.15)
		if S.ESP then
			local col = S.ESPRainbow and Color3.fromHSV((os.clock() % 4) / 4, 1, 1) or S.ESPColor
			local myhrp = U.hrp()
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LP then
					local ch = p.Character
					local hum = ch and ch:FindFirstChildOfClass("Humanoid")
					local head = ch and ch:FindFirstChild("Head")
					local dist = (myhrp and head) and math.floor((head.Position - myhrp.Position).Magnitude) or 0
					local skip = (S.ESPTeam and p.Team ~= nil and p.Team == LP.Team) or dist > (S.ESPMaxDist or 2000)
					if hum and head and hum.Health > 0 and not skip then
						local o = espObjs[p]
						if not o or o.char ~= ch or not o.hl.Parent then
							E.clearESP(p)
							local hl = U.new("Highlight", {FillTransparency = 0.6, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = ch}, ch)
							local bb = U.new("BillboardGui", {Size = UDim2.new(0, 170, 0, 36), StudsOffset = Vector3.new(0, 3, 0), AlwaysOnTop = true, Adornee = head}, ch)
							local lbl = U.new("TextLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, TextStrokeTransparency = 0}, bb)
							o = {hl = hl, bb = bb, lbl = lbl, char = ch}
							espObjs[p] = o
						end
						o.hl.FillColor = col o.hl.OutlineColor = col o.lbl.TextColor3 = col
						local parts = {}
						if S.ESPName then parts[#parts + 1] = p.Name end
						if S.ESPDist then parts[#parts + 1] = dist .. "m" end
						if S.ESPHealth then parts[#parts + 1] = math.floor(hum.Health) .. "HP" end
						o.lbl.Text = table.concat(parts, "  |  ")
						o.bb.Enabled = #parts > 0
					else
						E.clearESP(p)
					end
				end
			end
		elseif next(espObjs) then
			E.clearAllESP()
		end
	end
end)

