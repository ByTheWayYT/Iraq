Games.snake = function(x)
	local canvas = x.canvas
	local N, CELL = 16, 20
	local cells = {}
	for yy = 0, N - 1 do
		for xx = 0, N - 1 do
			cells[yy * N + xx] = U.new("Frame", {Size = UDim2.new(0, CELL - 1, 0, CELL - 1), Position = UDim2.new(0, xx * CELL, 0, yy * CELL),
				BackgroundColor3 = Color3.fromRGB(26, 16, 18), BorderSizePixel = 0}, canvas)
		end
	end
	local snake = {{8, 8}, {7, 8}, {6, 8}}
	local dir, ndir, food, score = {1, 0}, {1, 0}, nil, 0
	local function place()
		local ok
		repeat
			food = {math.random(0, N - 1), math.random(0, N - 1)}
			ok = true
			for _, s in ipairs(snake) do if s[1] == food[1] and s[2] == food[2] then ok = false end end
		until ok
	end
	place()
	local function draw()
		for _, c in pairs(cells) do c.BackgroundColor3 = Color3.fromRGB(26, 16, 18) end
		cells[food[2] * N + food[1]].BackgroundColor3 = Color3.fromRGB(255, 70, 70)
		for i, s in ipairs(snake) do cells[s[2] * N + s[1]].BackgroundColor3 = (i == 1) and Color3.fromRGB(255, 240, 120) or C.accent end
	end
	Games.press = function(d)
		if d == "up" and dir[2] == 0 then ndir = {0, -1} elseif d == "down" and dir[2] == 0 then ndir = {0, 1}
		elseif d == "left" and dir[1] == 0 then ndir = {-1, 0} elseif d == "right" and dir[1] == 0 then ndir = {1, 0} end
	end
	task.spawn(function()
		while x.live() do
			dir = ndir
			local h = snake[1]
			local nx, ny = h[1] + dir[1], h[2] + dir[2]
			local dead = nx < 0 or ny < 0 or nx >= N or ny >= N
			if not dead then for _, s in ipairs(snake) do if s[1] == nx and s[2] == ny then dead = true end end end
			if dead then draw() x.over(score) return end
			table.insert(snake, 1, {nx, ny})
			if nx == food[1] and ny == food[2] then score = score + 10 x.setScore(score) place() else table.remove(snake) end
			draw()
			task.wait(math.max(0.07, 0.17 - score * 0.0008))
		end
	end)
	draw()
end

Games.ttt = function(x)
	local canvas = x.canvas
	local b, btns, done = {}, {}, false
	local L3 = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}, {1, 4, 7}, {2, 5, 8}, {3, 6, 9}, {1, 5, 9}, {3, 5, 7}}
	local function winner(p)
		for _, l in ipairs(L3) do if b[l[1]] == p and b[l[2]] == p and b[l[3]] == p then return true end end
		return false
	end
	local function full() for i = 1, 9 do if not b[i] then return false end end return true end
	local function refresh() for i = 1, 9 do btns[i].Text = b[i] or "" end end
	local function try(p)
		for _, l in ipairs(L3) do
			local cnt, empty = 0, nil
			for _, i in ipairs(l) do if b[i] == p then cnt = cnt + 1 elseif not b[i] then empty = i end end
			if cnt == 2 and empty then return empty end
		end
		return nil
	end
	local function aiMove()
		local m = try("O") or try("X")
		if not m and not b[5] then m = 5 end
		if not m then
			local free = {}
			for i = 1, 9 do if not b[i] then free[#free + 1] = i end end
			m = free[math.random(#free)]
		end
		b[m] = "O"
	end
	for i = 1, 9 do
		local r, c = math.floor((i - 1) / 3), (i - 1) % 3
		btns[i] = U.new("TextButton", {Size = UDim2.new(0, 100, 0, 100), Position = UDim2.new(0, 6 + c * 107, 0, 6 + r * 107), BackgroundColor3 = C.row, Text = "",
			TextColor3 = C.white, Font = Enum.Font.GothamBold, TextSize = 56}, canvas)
		U.round(btns[i], 12)
		btns[i].MouseButton1Click:Connect(function()
			if done or b[i] then return end
			b[i] = "X" refresh()
			if winner("X") then done = true x.over(40, "YOU WIN 🎉") return end
			if full() then done = true x.over(10, "DRAW") return end
			aiMove() refresh()
			if winner("O") then done = true x.over(0, "YOU LOSE") elseif full() then done = true x.over(10, "DRAW") end
		end)
	end
end

Games.g2048 = function(x)
	local b, score, tiles = {}, 0, {}
	for r = 1, 4 do b[r] = {0, 0, 0, 0} end
	for r = 1, 4 do
		tiles[r] = {}
		for c = 1, 4 do
			tiles[r][c] = U.new("TextLabel", {Size = UDim2.new(0, 74, 0, 74), Position = UDim2.new(0, 6 + (c - 1) * 78, 0, 6 + (r - 1) * 78), BackgroundColor3 = Color3.fromRGB(50, 34, 36),
				Text = "", TextColor3 = Color3.fromRGB(20, 10, 10), Font = Enum.Font.GothamBold, TextSize = 26}, x.canvas)
			U.round(tiles[r][c], 10)
		end
	end
	local function draw()
		for r = 1, 4 do
			for c = 1, 4 do
				local v = b[r][c]
				tiles[r][c].Text = v > 0 and tostring(v) or ""
				tiles[r][c].BackgroundColor3 = v == 0 and Color3.fromRGB(50, 34, 36) or Color3.fromHSV((math.log(v, 2) * 0.09) % 1, 0.6, 0.95)
			end
		end
	end
	local function spawn()
		local free = {}
		for r = 1, 4 do for c = 1, 4 do if b[r][c] == 0 then free[#free + 1] = {r, c} end end end
		if #free == 0 then return end
		local p = free[math.random(#free)]
		b[p[1]][p[2]] = (math.random() < 0.9) and 2 or 4
	end
	local function slide(line)
		local t = {}
		for _, v in ipairs(line) do if v ~= 0 then t[#t + 1] = v end end
		local out, gain, i = {}, 0, 1
		while i <= #t do
			if t[i + 1] and t[i] == t[i + 1] then out[#out + 1] = t[i] * 2 gain = gain + t[i] * 2 i = i + 2
			else out[#out + 1] = t[i] i = i + 1 end
		end
		while #out < 4 do out[#out + 1] = 0 end
		return out, gain
	end
	local function move(d)
		local moved = false
		for k = 1, 4 do
			local pos = {}
			for i = 1, 4 do
				if d == "left" then pos[i] = {k, i} elseif d == "right" then pos[i] = {k, 5 - i}
				elseif d == "up" then pos[i] = {i, k} else pos[i] = {5 - i, k} end
			end
			local line = {}
			for i = 1, 4 do line[i] = b[pos[i][1]][pos[i][2]] end
			local out, gain = slide(line)
			for i = 1, 4 do
				if b[pos[i][1]][pos[i][2]] ~= out[i] then moved = true end
				b[pos[i][1]][pos[i][2]] = out[i]
			end
			score = score + gain
		end
		return moved
	end
	local function canMove()
		for r = 1, 4 do
			for c = 1, 4 do
				if b[r][c] == 0 then return true end
				if c < 4 and b[r][c] == b[r][c + 1] then return true end
				if r < 4 and b[r][c] == b[r + 1][c] then return true end
			end
		end
		return false
	end
	spawn() spawn() draw()
	Games.press = function(d)
		if d == "action" then return end
		if move(d) then
			spawn() draw() x.setScore(score)
			if not canMove() then x.over(score) end
		end
	end
end

Games.pong = function(x)
	local canvas, held = x.canvas, x.held
	local W, H, pw = 320, 320, 70
	local px, ax, bx, by, vx, vy, score = 125, 125, 155, 160, 120, 170, 0
	local function mk(w, h, col) return U.new("Frame", {Size = UDim2.new(0, w, 0, h), BackgroundColor3 = col, BorderSizePixel = 0}, canvas) end
	local pl, ai, ball = mk(pw, 8, C.accent), mk(pw, 8, Color3.fromRGB(120, 120, 255)), mk(10, 10, Color3.new(1, 1, 1))
	local last = os.clock()
	task.spawn(function()
		while x.live() do
			local now = os.clock()
			local dt = math.min(now - last, 0.05)
			last = now
			if held.left then px = px - 230 * dt end
			if held.right then px = px + 230 * dt end
			px = math.clamp(px, 0, W - pw)
			local tx = bx - pw / 2
			if ax < tx - 4 then ax = ax + 105 * dt elseif ax > tx + 4 then ax = ax - 105 * dt end
			ax = math.clamp(ax, 0, W - pw)
			bx = bx + vx * dt by = by + vy * dt
			if bx < 0 then bx = 0 vx = -vx elseif bx > W - 10 then bx = W - 10 vx = -vx end
			if by < 20 and vy < 0 and bx + 10 > ax and bx < ax + pw then by = 20 vy = -vy end
			if by > 290 and vy > 0 and by < 300 and bx + 10 > px and bx < px + pw then
				by = 290 vy = -vy * 1.04
				vx = math.clamp(vx + ((bx + 5) - (px + pw / 2)) * 3, -260, 260)
				score = score + 1 x.setScore(score)
			end
			if by > H then x.over(score) return end
			if by < -10 then score = score + 5 x.setScore(score) bx, by, vx, vy = 155, 160, 120, 170 end
			pl.Position = UDim2.new(0, px, 0, 300) ai.Position = UDim2.new(0, ax, 0, 12) ball.Position = UDim2.new(0, bx, 0, by)
			task.wait()
		end
	end)
end

