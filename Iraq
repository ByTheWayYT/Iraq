	local function applySearch(q)
		q = (q:lower():gsub("^%s+", ""):gsub("%s+$", ""))
		if q == "" then
			for _, r in ipairs(rows) do r.f.Parent = r.page r.f.Visible = true end
			for k, pg in pairs(pages) do pg.Visible = (k == UI.page) end
		else
			for _, r in ipairs(rows) do
				if r.name:find(q, 1, true) then r.f.Parent = pages.SEARCH r.f.Visible = true else r.f.Parent = r.page r.f.Visible = false end
			end
			for k, pg in pairs(pages) do pg.Visible = (k == "SEARCH") end
		end
	end
