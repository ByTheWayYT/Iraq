				end)
			end
			refresh()
		end
	end)
	refresh()

	task.spawn(function()
		local t0 = os.clock()
		while alive and Daily.gui == g do
			local t = os.clock() - t0
			local lg = tiles[7]
			lg.grad.Rotation = (90 + t * 70) % 360
			lg.stroke.Color = Color3.fromHSV((t * 0.35) % 1, 0.65, 1)
			for k, sp in ipairs(lg.spark) do sp.TextTransparency = 0.5 + 0.5 * math.sin(t * 5 + k * 2) end
			if todayIdx and tiles[todayIdx] then
				local tl = tiles[todayIdx]
				if todayIdx ~= 7 then tl.stroke.Color = tl.d.c1:Lerp(Color3.new(1, 1, 1), 0.5 + 0.5 * math.sin(t * 6)) end
